      "js-yaml": "^4.2.0",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "minimatch": "^3.1.3",
      "picomatch": "^2.3.2",
      "postcss": "^8.5.10",
      "qs": "^6.15.2",
      "rollup": "^4.59.0",
      "uuid": "^11.1.1",
      "yaml": "^1.10.3"
